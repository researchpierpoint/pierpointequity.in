{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"PirePoint Company Record",
  "type":"object",
  "required":["id","name","status","updated_at","facts","sources"],
  "properties":{
    "id":{"type":"string"},
    "name":{"type":"string"},
    "isin":{"type":["string","null"]},
    "ticker":{"type":["string","null"]},
    "exchange":{"type":["string","null"]},
    "status":{"enum":["active","inactive","unverified"]},
    "updated_at":{"type":"string","format":"date-time"},
    "facts":{"type":"array","items":{"$ref":"#/definitions/fact"}},
    "sources":{"type":"array","items":{"$ref":"#/definitions/source"}}
  },
  "definitions":{
    "fact":{
      "type":"object",
      "required":["field","value","as_of","source_ids","confidence"],
      "properties":{
        "field":{"type":"string"},
        "value":{},
        "unit":{"type":["string","null"]},
        "as_of":{"type":"string"},
        "source_ids":{"type":"array","items":{"type":"string"}},
        "confidence":{"enum":["high","medium","low","unknown"]},
        "classification":{"enum":["fact","calculation","interpretation","forecast","opinion","unknown"]}
      }
    },
    "source":{
      "type":"object",
      "required":["id","url","title","source_tier","retrieved_at"],
      "properties":{
        "id":{"type":"string"},
        "url":{"type":"string","format":"uri"},
        "title":{"type":"string"},
        "publisher":{"type":["string","null"]},
        "published_at":{"type":["string","null"]},
        "retrieved_at":{"type":"string","format":"date-time"},
        "source_tier":{"enum":[1,2,3,4,5]},
        "document_ref":{"type":["string","null"]},
        "notes":{"type":["string","null"]}
      }
    }
  }
}