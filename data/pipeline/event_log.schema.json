{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PirePoint Material Change Event",
  "type": "object",
  "required": ["event_id","entity_id","detected_at","changes","materiality","status"],
  "properties": {
    "event_id":{"type":"string"},
    "entity_id":{"type":"string"},
    "detected_at":{"type":"string","format":"date-time"},
    "changes":{"type":"array","items":{"type":"object"}},
    "materiality":{"enum":["none","review","high"]},
    "status":{"enum":["detected","needs_red_team","needs_compliance","published","rejected"]}
  }
}